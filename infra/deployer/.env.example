# Shared secret with the Gitea webhook. Generate with:
#   openssl rand -hex 32
WEBHOOK_SECRET=

# Gitea access token with read access to both repositories. Create at
# Gitea -> Settings -> Applications -> Generate Token, scope: read:repository.
# Used only in the remote URL, in memory — never written into a checkout.
GITEA_USER=deploy
GITEA_TOKEN=

# Host paths. These are passed to `docker run -v` for the build container, so they
# must be the paths as the HOST sees them, not as this container does.
DEPLOY_ROOT_HOST=/srv/deploy
WWW_ROOT_HOST=/srv/www

# Warehouse builds only. A wrong URL ships an app that cannot reach its database,
# and it is compiled in, so it cannot be corrected without rebuilding.
VITE_SUPABASE_URL=https://api.makebelievestudio.app
VITE_SUPABASE_ANON_KEY=
